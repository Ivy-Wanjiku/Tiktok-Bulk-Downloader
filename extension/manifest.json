{
  "manifest_version": 3,
  "name": "TikTok Bulk Downloader",
  "version": "1.0.1",
  "description": "Bulk download TikTok videos from user profiles with auto-scroll and smart duplicate detection. Features demo mode for easy testing without backend setup.",
  "author": "Joombah",
  "homepage_url": "https://github.com/Joombah/Tiktok-Bulk-Downloader",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "*://*.tiktok.com/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "TikTok Bulk Downloader - Click to open (includes demo mode)",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.tiktok.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
