# TikTok Bulk Downloader - Environment Configuration
# Copy this file to .env and customize for your environment

# ============================================
# API Server Configuration
# ============================================
API_HOST=0.0.0.0
API_PORT=3000
ENVIRONMENT=production

# ============================================
# Security Configuration
# ============================================
# Comma-separated list of allowed origins for CORS
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://127.0.0.1:8080

# Enable API key authentication (recommended for production)
ENABLE_AUTH=false
# API_KEY=your-secure-api-key-here

# ============================================
# Download Configuration
# ============================================
# Maximum concurrent downloads (1-5 recommended)
MAX_CONCURRENT_DOWNLOADS=3

# Job timeout in hours (mark jobs as stale after this time)
JOB_TIMEOUT_HOURS=2

# ============================================
# Database Configuration
# ============================================
# SQLite database is created automatically in project root
# DB_PATH=tiktok_downloader.db

# ============================================
# Logging Configuration
# ============================================
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
